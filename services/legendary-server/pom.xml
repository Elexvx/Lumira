<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.legendary.invention</groupId>
        <artifactId>legendary-invention-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>legendary-server</artifactId>
    <name>legendary-server</name>

    <dependencies>
        <dependency>
            <groupId>com.legendary.invention</groupId>
            <artifactId>system-service</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.legendary.invention</groupId>
            <artifactId>auth-service</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.legendary.invention</groupId>
            <artifactId>file-service</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.legendary.invention</groupId>
            <artifactId>message-service</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.legendary.invention</groupId>
            <artifactId>plugin-service</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.legendary.invention</groupId>
            <artifactId>localization-service</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.legendary.invention</groupId>
            <artifactId>job-executor</artifactId>
            <version>0.1.0</version>
        </dependency>
        
        <!-- MySQL driver if not already in system-service -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
