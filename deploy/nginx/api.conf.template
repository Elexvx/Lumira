limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=api_conn_per_ip:10m;

server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;
    # Generated atomically by lumira-updater. Keeping the variables inside the
    # server context lets Nginx reload traffic without restarting the proxy.
    include /etc/nginx/lumira-upstreams/active-upstreams.conf;

    client_max_body_size 200m;
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn api_conn_per_ip 80;

    location = /health {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location = /api/health {
        limit_req zone=api_per_ip burst=80 nodelay;
        proxy_pass http://$system_upstream/api/health;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/api/(ai|tasks|approvals|evaluations)(/|$) {
        limit_req zone=api_per_ip burst=40 nodelay;
        proxy_pass http://$system_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/api/v1/(dashboard|profile|audit)(/|$) {
        limit_req zone=api_per_ip burst=80 nodelay;
        proxy_pass http://$system_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/p/ {
        limit_req zone=api_per_ip burst=80 nodelay;
        proxy_pass http://$plugin_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /ws/message {
        proxy_pass http://$message_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /internal/auth {
