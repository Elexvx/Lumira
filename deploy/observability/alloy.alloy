local.file_match "docker_json_logs" {
  path_targets = [{
    __path__    = "/var/lib/docker/containers/*/*-json.log",
    environment = sys.env("OBSERVABILITY_ENVIRONMENT"),
    platform    = "lumira",
    source      = "docker-json-file",
  }]
}

loki.source.file "docker_json_logs" {
  targets       = local.file_match.docker_json_logs.targets
  tail_from_end = true
  forward_to    = [loki.process.docker_json.receiver]
}

loki.process "docker_json" {
  stage.json {
    expressions = {
      output = "log",
      stream = "stream",
      time   = "time",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      stream = "",
    }
  }

  stage.output {
    source = "output"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
