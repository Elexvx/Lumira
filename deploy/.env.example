# Example values for deployment. Every value prefixed with change-me is a
# placeholder and must be replaced with a strong production secret before launch.

MYSQL_DATABASE=saas

API_DOMAIN=bm.aiadc.org.cn
FRONTEND_ORIGIN=https://bm.aiadc.org.cn

APP_VERSION=0.1.0
# Build identity is generated by bin/deploy-container.mjs and injected through
# deploy/build-identity.env. Production deploys should not run docker compose
# directly unless these fields are explicitly set to the release commit.
BUILD_VERSION=
BUILD_TIME=
GIT_COMMIT=
GIT_BRANCH=
PLATFORM_UPDATE_SOURCE_URL=https://api.github.com/repos/Elexvx/lumira/commits/main
# CI publishes the digest-pinned continuous release manifest in this GitHub release.
PLATFORM_UPDATE_MANIFEST_URL=https://api.github.com/repos/Elexvx/Lumira/releases/tags/continuous
PLATFORM_UPDATE_AGENT_URL=http://host.docker.internal:9788
PLATFORM_UPDATE_AGENT_ALLOWED_HOSTS=host.docker.internal
PLATFORM_UPDATE_AGENT_TOKEN=change-me-local-updater-token
LUMIRA_RUNTIME_CONTROL_TOKEN=change-me-runtime-control-token-32chars
LUMIRA_UPDATER_ALLOW_INLINE_MANIFEST=false
LUMIRA_RELEASE_SOURCE_URL=https://github.com/Elexvx/Lumira/releases/download/{releaseId}/lumira-release-envelope.json
LUMIRA_RELEASE_ALLOWED_HOSTS=github.com,objects.githubusercontent.com
LUMIRA_RELEASE_TRUSTED_PUBLIC_KEYS_FILE=./release-trusted-public-keys.json
LUMIRA_RELEASE_ALLOWED_KEY_IDS=lumira-release-2026-01
LUMIRA_RELEASE_ALLOWED_CHANNELS=stable
LUMIRA_RELEASE_MAX_MANIFEST_BYTES=524288
LUMIRA_RELEASE_MAX_AGE_SECONDS=7776000
PLATFORM_UPDATE_ALLOWED_IMAGE_PREFIXES=ghcr.io/elexvx/lumira/,swr.cn-east-3.myhuaweicloud.com/aiadc/
LUMIRA_UPDATER_HOST=127.0.0.1
LUMIRA_UPDATER_PORT=9788
# Abort a registry pull after 5 minutes without output or 30 minutes overall.
# Increase these only when the registry is known to be slow but still progressing.
LUMIRA_UPDATER_PULL_NO_PROGRESS_TIMEOUT_MS=300000
LUMIRA_UPDATER_PULL_TIMEOUT_MS=1800000

# CI publishes these images after lumira-backend and lumira-ui builds pass on main.
# For a fixed release, replace main with sha-<12-char-commit>.
LUMIRA_SERVER_IMAGE=ghcr.io/elexvx/lumira/lumira-server:main
LUMIRA_SERVER_BLUE_IMAGE=ghcr.io/elexvx/lumira/lumira-server:main
LUMIRA_SERVER_GREEN_IMAGE=ghcr.io/elexvx/lumira/lumira-server:main
LUMIRA_SERVER_BLUE_APP_VERSION=
LUMIRA_SERVER_GREEN_APP_VERSION=
LUMIRA_SERVER_BLUE_BUILD_VERSION=
LUMIRA_SERVER_GREEN_BUILD_VERSION=
LUMIRA_SERVER_BLUE_FRONTEND_VERSION=
LUMIRA_SERVER_GREEN_FRONTEND_VERSION=
LUMIRA_SERVER_BLUE_BACKEND_VERSION=
LUMIRA_SERVER_GREEN_BACKEND_VERSION=
LUMIRA_SERVER_BLUE_BUILD_TIME=
LUMIRA_SERVER_GREEN_BUILD_TIME=
LUMIRA_SERVER_BLUE_GIT_COMMIT=
LUMIRA_SERVER_GREEN_GIT_COMMIT=
LUMIRA_SERVER_BLUE_GIT_BRANCH=
LUMIRA_SERVER_GREEN_GIT_BRANCH=
LUMIRA_SERVER_BLUE_DATABASE_VERSION=
LUMIRA_SERVER_GREEN_DATABASE_VERSION=
LUMIRA_ACTIVE_SLOT=blue
LUMIRA_ASYNC_IMAGE=ghcr.io/elexvx/lumira/lumira-async:main
LUMIRA_JOB_EXECUTOR_IMAGE=ghcr.io/elexvx/lumira/lumira-job-executor:main
LUMIRA_MIGRATOR_IMAGE=ghcr.io/elexvx/lumira/lumira-migrator:main
LUMIRA_FRONTEND_IMAGE=ghcr.io/elexvx/lumira/lumira-ui:main

# Trusted domestic registry mirrors used by local and production rebuilds.
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.4
MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9.11-eclipse-temurin-21
MAVEN_MIRROR_URL=https://mirrors.cloud.tencent.com/nexus/repository/maven-public
MAVEN_FALLBACK_MIRROR_URL=https://repo.huaweicloud.com/repository/maven
JRE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:21-jre
FLYWAY_IMAGE=docker.m.daocloud.io/redgate/flyway:12.5.0
NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.29-alpine
NPM_REGISTRY=https://registry.npmmirror.com
NPM_FALLBACK_REGISTRY=https://mirrors.cloud.tencent.com/npm

OBSERVABILITY_ENVIRONMENT=prod
OTEL_JAVAAGENT_ENABLED=false
OTEL_JAVAAGENT_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
PROMETHEUS_IMAGE=docker.m.daocloud.io/prom/prometheus@sha256:e4254400b85610324913f0dc4acf92603d9984e7519414c5a12811aa6146acc3
MYSQLD_EXPORTER_IMAGE=docker.m.daocloud.io/prom/mysqld-exporter@sha256:eacb4b18e2ec1e0abdf2d64851b68526c964f6d9cb3e9458fb5d5f5062ea94c1
NODE_EXPORTER_IMAGE=docker.m.daocloud.io/prom/node-exporter@sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0
REDIS_EXPORTER_IMAGE=docker.m.daocloud.io/oliver006/redis_exporter@sha256:120f7ec77293459ccfdad66bb1db75ab72e8bfeab99f58b1cc2564cadcd7a9e7
GRAFANA_IMAGE=docker.m.daocloud.io/grafana/grafana@sha256:2d1f9ae67c1778d33e291d4c3c759cd8b650e67491f02533499eb950e075eeb5
LOKI_IMAGE=docker.m.daocloud.io/grafana/loki@sha256:191d4fdfb7264f16989f0a57f320872620a5a7c2ceeec6229212c4190ec49b86
TEMPO_IMAGE=docker.m.daocloud.io/grafana/tempo@sha256:2513658c41faa9197dc7373599bb6119eb27bcb4232cc83779e2bc87cbc34299
ALLOY_IMAGE=docker.m.daocloud.io/grafana/alloy@sha256:51aeb9d829239345070619dad3edd6873186f913c84f45b365b74574fcb38ec0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
GRAFANA_ALERT_EMAIL_ENABLED=false
GRAFANA_ALERT_EMAIL_TO=
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM_ADDRESS=alerts@lumira.local
GRAFANA_SMTP_FROM_NAME=Lumira Observability
GRAFANA_ALERT_WEBHOOK_ENABLED=false
GRAFANA_ALERT_WEBHOOK_URL=

# Built-in alerting remains disabled until explicitly enabled in Plugin Management.
# Set a random secret of at least 32 characters before creating any channel instance.
ALERTING_SECRETS_MASTER_KEY=
ALERTING_PROMETHEUS_BASE_URL=http://prometheus:9090
ALERTING_UI_BASE_URL=
ALERTING_ALLOW_PRIVATE_TARGETS=false
# Provision this least-privilege account in managed MySQL before enabling the
# observability profile. Local bundled MySQL is provisioned by deploy-container.
MYSQLD_EXPORTER_ADDRESS=mysql:3306
MYSQLD_EXPORTER_USERNAME=exporter
MYSQLD_EXPORTER_PASSWORD=change-me-mysql-exporter-password
# Optional secret-manager-owned file. Leave empty to let the deployment tools
# create deploy/.generated/secrets/mysql-exporter-password with mode 0600.
MYSQLD_EXPORTER_PASSWORD_FILE=
# Required for an external/managed MYSQLD_EXPORTER_ADDRESS, which must exactly
# match DB_URL host:port. The config may contain only [client], the mounted CA
# path /run/secrets/mysql_exporter_ca, and tls=custom.
MYSQLD_EXPORTER_CONFIG_FILE=
MYSQLD_EXPORTER_CA_FILE=

REDIS_PASSWORD=change-me-at-least-24-characters-redis-password
REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384m


DB_USERNAME=root
DB_PASSWORD=change-me-strong-mysql-password
DB_URL=jdbc:mysql://mysql:3306/saas?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
# Use a separate schema-migration identity in production. Empty values retain
# compatibility by falling back to DB_USERNAME/DB_PASSWORD and trigger a warning.
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=
DB_MIGRATION_NETWORK=deploy_default
DB_BACKUP_NETWORK=deploy_default

# Logical backup and verified migration gate. Dedicated credentials are
# recommended; empty values fall back to the application database identity.
MYSQL_BACKUP_USERNAME=
MYSQL_BACKUP_PASSWORD=
MYSQL_RESTORE_USERNAME=
MYSQL_RESTORE_PASSWORD=
MYSQL_SSL_MODE=
MYSQL_SSL_CA_FILE=
BACKUP_ROOT=/var/backups/lumira
BACKUP_RETENTION_DAYS=0
BACKUP_UPLOAD_HOOK=
BACKUP_ALLOW_EMPTY_DATABASE=0
BACKUP_REDIS=1
BACKUP_EVIDENCE_MAX_AGE_MS=21600000
BACKUP_METRICS_FILE=deploy/.generated/backup-metrics/lumira-mysql.prom

# Bundled MySQL durability/PITR defaults. Managed MySQL must be configured in
# its provider control plane and verified with database-production-audit.mjs.
MYSQL_SERVER_ID=1
MYSQL_LOG_BIN_BASENAME=mysql-bin
MYSQL_BINLOG_FORMAT=ROW
MYSQL_GTID_MODE=ON
MYSQL_ENFORCE_GTID_CONSISTENCY=ON
MYSQL_BINLOG_EXPIRE_LOGS_SECONDS=1209600
MYSQL_SYNC_BINLOG=1
MYSQL_INNODB_FLUSH_LOG_AT_TRX_COMMIT=1
MYSQL_PERFORMANCE_SCHEMA=ON

JWT_SECRET=change-me-at-least-32-characters-jwt-secret-for-production
FIELD_SECRET=change-me-at-least-32-characters-field-secret-for-production
PLUGIN_SIGNATURE_SECRET=change-me-at-least-32-characters-plugin-signature-secret

# Optional WeChat Open Platform website login. Set all values, register the
# exact redirect URI in the WeChat Open Platform console, and restart the
# auth/system services before expecting the QR login capability to be true.
WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://your-domain.com/api/v2/auth/wechat/callback
WECHAT_STATE_EXPIRE_MINUTES=10

# Use distinct scoped internal service tokens in production. Every deployed
# internal API domain should have its own strong secret.
SAAS_INTERNAL_SYSTEM_TOKEN=change-me-at-least-24-characters-system-internal-token
SAAS_INTERNAL_AUTH_TOKEN=change-me-at-least-24-characters-auth-internal-token
SAAS_INTERNAL_AUTH_SYSTEM_TOKEN=change-me-at-least-24-characters-auth-system-internal-token
SAAS_INTERNAL_FILE_TOKEN=change-me-at-least-24-characters-file-internal-token
SAAS_INTERNAL_MESSAGE_TOKEN=change-me-at-least-24-characters-message-internal-token
SAAS_INTERNAL_PAYMENT_TOKEN=change-me-at-least-24-characters-payment-internal-token
SAAS_INTERNAL_PLUGIN_TOKEN=change-me-at-least-24-characters-plugin-internal-token
SAAS_INTERNAL_TEAM_TOKEN=change-me-at-least-24-characters-team-internal-token
SAAS_INTERNAL_JOB_TOKEN=change-me-at-least-24-characters-job-internal-token

# The Async runtime does not package Auth or Team. These two genuine
# cross-runtime calls go through api-proxy and therefore always reach the
# active blue/green control-plane slot.
AUTH_SERVICE_BASE_URL=http://api-proxy:80
TEAM_SERVICE_BASE_URL=http://api-proxy:80
LUMIRA_ASYNC_CONTROL_PLANE_BASE_URL=http://api-proxy:80

# Production synchronously serves every public owner route from the active
# lumira-server slot. The proxy has no owner-service upstream overrides.
# Job Executor only makes the two real runtime hops below: Async owner jobs and
# control-plane exports/review maintenance. The old per-service URL names are
# accepted by application compatibility fallbacks, but are intentionally not
# injected or documented for formal production deployment.
SAAS_JOB_ASYNC_RUNTIME_BASE_URL=http://lumira-async:8080
SAAS_JOB_CONTROL_PLANE_BASE_URL=http://api-proxy:80

# Reliable async delivery defaults. MySQL outbox remains the source of truth;
# Redis Streams is the production delivery transport. Set the dispatcher to
# logging only for an explicit local diagnostic run with stream consumers off.
SAAS_EVENT_OUTBOX_RELAY_ENABLED=true
SAAS_EVENT_OUTBOX_DISPATCHER=redis-stream
SAAS_EVENT_OUTBOX_BATCH_SIZE=100
SAAS_EVENT_OUTBOX_MAX_DRAIN_ROUNDS=4
SAAS_EVENT_OUTBOX_MAX_BURST_ROUNDS=12
SAAS_EVENT_REDIS_STREAM_KEY=saas:platform-events
LUMIRA_PAYMENT_EVENT_CONSUMER_ENABLED=true
LUMIRA_PAYMENT_EVENT_CONSUMER_STREAM_KEY=lumira.events.payment.v1
LUMIRA_PAYMENT_EVENT_CONSUMER_GROUP_NAME=competition-payment-v1
LUMIRA_PAYMENT_EVENT_CONSUMER_NAME=
LUMIRA_PAYMENT_EVENT_CONSUMER_PENDING_RECOVERY_MINIMUM_IDLE=30s
LUMIRA_PAYMENT_EVENT_CONSUMER_PENDING_RECOVERY_INTERVAL=30s
LUMIRA_PAYMENT_EVENT_CONSUMER_MAX_DELIVERY_COUNT=8
LUMIRA_EVENT_REVIEW_RESULT_CONSUMER_ENABLED=true
LUMIRA_EVENT_REVIEW_RESULT_CONSUMER_STREAM_KEY=saas:platform-events
LUMIRA_EVENT_REVIEW_RESULT_CONSUMER_GROUP_NAME=message-review-result-v1
SAAS_WORKFLOW_LEGACY_STAGE_REVIEW_ENABLED=false
SAAS_JOB_ADAPTIVE_RELAY_ENABLED=true
SAAS_JOB_ADAPTIVE_RELAY_INITIAL_DELAY_MS=5000
SAAS_JOB_ADAPTIVE_RELAY_MIN_DELAY_MS=1000
SAAS_JOB_ADAPTIVE_RELAY_MAX_DELAY_MS=30000
SAAS_JOB_ADAPTIVE_RELAY_FAILURE_DELAY_MS=10000

# Host path to a secret-manager-provisioned file containing the one-time
# built-in administrator password. It is mounted read-only into the database
# migrator, never injected into the business server, and is ignored after the
# administrator credential has been initialized once.
LUMIRA_BOOTSTRAP_ADMIN_PASSWORD_FILE=

XXL_JOB_ADMIN_ACCESS_TOKEN=change-me-xxl-job-token
XXL_JOB_ACCESS_TOKEN=change-me-xxl-job-token
XXL_JOB_LOGIN_PASSWORD=change-me-xxl-admin-password
XXL_JOB_VERSION=3.4.0
XXL_JOB_ADMIN_IMAGE=lumira/xxl-job-admin:3.4.0

UPLOAD_STORAGE_ROOT=/data/uploads
PLUGIN_STORAGE_ROOT=/data/plugins
PLUGIN_STAGING_ROOT=/data/plugin-staging
XXL_JOB_EXECUTOR_LOG_HOST_PATH=/opt/lumira/data/xxl-job/logs

JAVA_OPTS=-XX:MaxRAMPercentage=58 -XX:InitialRAMPercentage=18 -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=96m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Djava.security.egd=file:/dev/./urandom

# 4C4G friendly defaults. Increase these only after observing CPU, heap, Redis,
# MySQL connections, and 429 rates under real traffic.
SERVER_TOMCAT_THREADS_MAX=80
SERVER_TOMCAT_THREADS_MIN_SPARE=8
SERVER_TOMCAT_ACCEPT_COUNT=120
SERVER_TOMCAT_MAX_CONNECTIONS=4096
SPRING_THREADS_VIRTUAL_ENABLED=true
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=4
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
# HikariCP 6.2+ enables a periodic JDBC keepalive by default. Keep it disabled
# until the upstream ConcurrentBag keepalive spin fix is available in our stack.
SPRING_DATASOURCE_HIKARI_KEEPALIVE_TIME=0
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=2
SYSTEM_SERVICE_MEM_LIMIT=768m
SYSTEM_SERVICE_CPUS=2.0
GATEWAY_SERVICE_MEM_LIMIT=512m
AUTH_SERVICE_MEM_LIMIT=384m
FILE_SERVICE_MEM_LIMIT=384m
MESSAGE_SERVICE_MEM_LIMIT=384m
PLUGIN_SERVICE_MEM_LIMIT=384m
LOCALIZATION_SERVICE_MEM_LIMIT=320m
JOB_EXECUTOR_MEM_LIMIT=320m
XXL_JOB_ADMIN_MEM_LIMIT=384m
API_PROXY_MEM_LIMIT=128m

SAAS_TRAFFIC_GATEWAY_AUTH_SERVICE_QPS=120
SAAS_TRAFFIC_GATEWAY_FILE_SERVICE_QPS=80
SAAS_TRAFFIC_GATEWAY_MESSAGE_SERVICE_QPS=80
SAAS_TRAFFIC_GATEWAY_PLUGIN_SERVICE_QPS=50
SAAS_TRAFFIC_GATEWAY_LOCALIZATION_SERVICE_QPS=80
SAAS_TRAFFIC_GATEWAY_SYSTEM_SERVICE_QPS=160
SAAS_TRAFFIC_AUTH_LOGIN_QPS=20
SAAS_TRAFFIC_AUTH_REFRESH_TOKEN_QPS=80
SAAS_TRAFFIC_AUTH_CURRENT_USER_QPS=160

# Comma-separated exact lumira-ui origins allowed by the lumira-backend gateway.
# Do not use wildcard domains for the admin console.
CORS_ALLOWED_ORIGIN_PATTERNS=https://bm.aiadc.org.cn

# Backend API proxy bind address. Keep it on localhost when HTTPS is terminated
# by the edge proxy, host Nginx, 1Panel, a load balancer, or CDN tunnel.
API_PROXY_BIND=127.0.0.1:8000

# Local Release Set UI slots. The edge proxy switches both UI and API from the
# same generated upstream file; these loopback binds are diagnostic only.
FRONTEND_BLUE_BIND=127.0.0.1:8001
FRONTEND_GREEN_BIND=127.0.0.1:8002
