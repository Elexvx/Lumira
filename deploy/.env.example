# Example values for deployment. Every value prefixed with change-me is a
# placeholder and must be replaced with a strong production secret before launch.

MYSQL_DATABASE=saas

API_DOMAIN=bm.aiadc.org.cn
FRONTEND_ORIGIN=https://bm.aiadc.org.cn

APP_VERSION=0.1.0
# Build identity is generated by bin/deploy-container.mjs and injected through
# deploy/build-identity.env. Production deploys should not run docker compose
# directly unless these fields are explicitly set to the release commit.
BUILD_VERSION=
BUILD_TIME=
GIT_COMMIT=
GIT_BRANCH=
PLATFORM_UPDATE_SOURCE_URL=https://api.github.com/repos/Elexvx/lumira/commits/main
# CI publishes the digest-pinned continuous release manifest in this GitHub release.
PLATFORM_UPDATE_MANIFEST_URL=https://api.github.com/repos/Elexvx/Lumira/releases/tags/continuous
PLATFORM_UPDATE_AGENT_URL=http://host.docker.internal:9788
PLATFORM_UPDATE_AGENT_ALLOWED_HOSTS=host.docker.internal
PLATFORM_UPDATE_AGENT_TOKEN=change-me-local-updater-token
PLATFORM_UPDATE_ALLOWED_IMAGE_PREFIXES=ghcr.io/elexvx/lumira/
LUMIRA_UPDATER_HOST=127.0.0.1
LUMIRA_UPDATER_PORT=9788

# CI publishes these images after lumira-backend and lumira-ui builds pass on main.
# For a fixed release, replace main with sha-<12-char-commit>.
LUMIRA_SERVER_IMAGE=ghcr.io/elexvx/lumira/lumira-server:main
LUMIRA_SERVER_BLUE_IMAGE=ghcr.io/elexvx/lumira/lumira-server:main
LUMIRA_SERVER_GREEN_IMAGE=ghcr.io/elexvx/lumira/lumira-server:main
LUMIRA_ACTIVE_SLOT=blue
LUMIRA_ASYNC_IMAGE=ghcr.io/elexvx/lumira/lumira-async:main
LUMIRA_JOB_EXECUTOR_IMAGE=ghcr.io/elexvx/lumira/lumira-job-executor:main
LUMIRA_FRONTEND_IMAGE=ghcr.io/elexvx/lumira/lumira-ui:main

# Optional trusted registry mirrors for local rebuilds when Docker Hub is slow.
MAVEN_IMAGE=maven:3.9.11-eclipse-temurin-21
JRE_IMAGE=eclipse-temurin:21-jre
NODE_IMAGE=node:22-bookworm-slim
NGINX_IMAGE=nginx:1.29-alpine

OBSERVABILITY_ENVIRONMENT=prod
OTEL_JAVAAGENT_ENABLED=false
OTEL_JAVAAGENT_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
PROMETHEUS_IMAGE=prom/prometheus@sha256:e4254400b85610324913f0dc4acf92603d9984e7519414c5a12811aa6146acc3
GRAFANA_IMAGE=grafana/grafana@sha256:2d1f9ae67c1778d33e291d4c3c759cd8b650e67491f02533499eb950e075eeb5
LOKI_IMAGE=grafana/loki@sha256:191d4fdfb7264f16989f0a57f320872620a5a7c2ceeec6229212c4190ec49b86
TEMPO_IMAGE=grafana/tempo@sha256:2513658c41faa9197dc7373599bb6119eb27bcb4232cc83779e2bc87cbc34299
ALLOY_IMAGE=grafana/alloy@sha256:51aeb9d829239345070619dad3edd6873186f913c84f45b365b74574fcb38ec0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
GRAFANA_ALERT_EMAIL_ENABLED=false
GRAFANA_ALERT_EMAIL_TO=
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM_ADDRESS=alerts@lumira.local
GRAFANA_SMTP_FROM_NAME=Lumira Observability
GRAFANA_ALERT_WEBHOOK_ENABLED=false
GRAFANA_ALERT_WEBHOOK_URL=

REDIS_PASSWORD=change-me-at-least-24-characters-redis-password
REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384m

# Must be Base64 and decode to at least 32 bytes for Nacos 3.x.
NACOS_AUTH_TOKEN=Y2hhbmdlLW1lLW5hY29zLWF1dGgtdG9rZW4tYXQtbGVhc3QtMzItYnl0ZXM=
NACOS_AUTH_IDENTITY_KEY=change-me-nacos-identity-key
NACOS_AUTH_IDENTITY_VALUE=change-me-nacos-identity-value
NACOS_CONFIG_ENABLED=false
NACOS_DISCOVERY_ENABLED=false
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=

DB_USERNAME=root
DB_PASSWORD=change-me-strong-mysql-password
DB_URL=jdbc:mysql://mysql:3306/saas?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_MIGRATION_NETWORK=1panel-network
DB_BACKUP_NETWORK=1panel-network

JWT_SECRET=change-me-at-least-32-characters-jwt-secret-for-production
FIELD_SECRET=change-me-at-least-32-characters-field-secret-for-production
PLUGIN_SIGNATURE_SECRET=change-me-at-least-32-characters-plugin-signature-secret

# Use distinct scoped internal service tokens in production. Every deployed
# internal API domain should have its own strong secret.
SAAS_INTERNAL_SYSTEM_TOKEN=change-me-at-least-24-characters-system-internal-token
SAAS_INTERNAL_AUTH_TOKEN=change-me-at-least-24-characters-auth-internal-token
SAAS_INTERNAL_AUTH_SYSTEM_TOKEN=change-me-at-least-24-characters-auth-system-internal-token
SAAS_INTERNAL_FILE_TOKEN=change-me-at-least-24-characters-file-internal-token
SAAS_INTERNAL_MESSAGE_TOKEN=change-me-at-least-24-characters-message-internal-token
SAAS_INTERNAL_PAYMENT_TOKEN=change-me-at-least-24-characters-payment-internal-token
SAAS_INTERNAL_PLUGIN_TOKEN=change-me-at-least-24-characters-plugin-internal-token
SAAS_INTERNAL_TEAM_TOKEN=change-me-at-least-24-characters-team-internal-token
SAAS_INTERNAL_JOB_TOKEN=change-me-at-least-24-characters-job-internal-token

# Optional internal service base URL overrides for split deployments. In the
# default monolith+worker topology these go through api-proxy so workers always
# reach the active blue/green slot.
AUTH_SERVICE_BASE_URL=http://api-proxy:80
TEAM_SERVICE_BASE_URL=http://api-proxy:80

# API proxy upstream overrides for split deployments. These stay on the shared
# monolith entrypoint until an owner service is explicitly promoted behind the
# proxy.
GATEWAY_UPSTREAM=lumira-server:8080
SYSTEM_SERVICE_UPSTREAM=lumira-server:8080
AUTH_SERVICE_UPSTREAM=lumira-server:8080
FILE_SERVICE_UPSTREAM=lumira-server:8080
MESSAGE_SERVICE_UPSTREAM=lumira-server:8080
PLUGIN_SERVICE_UPSTREAM=lumira-server:8080
PAYMENT_SERVICE_UPSTREAM=lumira-server:8080
LOCALIZATION_SERVICE_UPSTREAM=lumira-server:8080
TEAM_SERVICE_UPSTREAM=lumira-server:8080
AI_SERVICE_UPSTREAM=lumira-server:8080

SAAS_JOB_MESSAGE_SERVICE_BASE_URL=http://lumira-async:8080
SAAS_JOB_FILE_SERVICE_BASE_URL=http://lumira-async:8080
SAAS_JOB_PAYMENT_SERVICE_BASE_URL=http://lumira-async:8080
SAAS_JOB_PLUGIN_SERVICE_BASE_URL=http://lumira-async:8080

# Reliable async delivery defaults. Keep logging as the primary dispatcher so
# MySQL outbox remains the source of truth; switch to redis-stream only when a
# downstream stream consumer is deployed.
SAAS_EVENT_OUTBOX_RELAY_ENABLED=true
SAAS_EVENT_OUTBOX_DISPATCHER=logging
SAAS_EVENT_OUTBOX_BATCH_SIZE=100
SAAS_EVENT_OUTBOX_MAX_DRAIN_ROUNDS=4
SAAS_EVENT_OUTBOX_MAX_BURST_ROUNDS=12
SAAS_EVENT_REDIS_STREAM_KEY=saas:platform-events
SAAS_JOB_ADAPTIVE_RELAY_ENABLED=true
SAAS_JOB_ADAPTIVE_RELAY_INITIAL_DELAY_MS=5000
SAAS_JOB_ADAPTIVE_RELAY_MIN_DELAY_MS=1000
SAAS_JOB_ADAPTIVE_RELAY_MAX_DELAY_MS=30000
SAAS_JOB_ADAPTIVE_RELAY_FAILURE_DELAY_MS=10000

# Optional production-only first-login password for the built-in admin account.
# If left blank/unset, a fresh database uses admin / 123456 and still forces an immediate password change.
LUMIRA_INITIAL_ADMIN_PASSWORD=

XXL_JOB_ADMIN_ACCESS_TOKEN=change-me-xxl-job-token
XXL_JOB_ACCESS_TOKEN=change-me-xxl-job-token
XXL_JOB_LOGIN_PASSWORD=change-me-xxl-admin-password
XXL_JOB_VERSION=3.4.0
XXL_JOB_ADMIN_IMAGE=lumira/xxl-job-admin:3.4.0

UPLOAD_STORAGE_ROOT=/data/uploads
PLUGIN_STORAGE_ROOT=/data/plugins
PLUGIN_STAGING_ROOT=/data/plugin-staging
XXL_JOB_EXECUTOR_LOG_HOST_PATH=/opt/lumira/data/xxl-job/logs

JAVA_OPTS=-XX:MaxRAMPercentage=58 -XX:InitialRAMPercentage=18 -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=96m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Djava.security.egd=file:/dev/./urandom

# 4C4G friendly defaults. Increase these only after observing CPU, heap, Redis,
# MySQL connections, and 429 rates under real traffic.
SERVER_TOMCAT_THREADS_MAX=80
SERVER_TOMCAT_THREADS_MIN_SPARE=8
SERVER_TOMCAT_ACCEPT_COUNT=120
SERVER_TOMCAT_MAX_CONNECTIONS=4096
SPRING_THREADS_VIRTUAL_ENABLED=true
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=4
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=2
SYSTEM_SERVICE_MEM_LIMIT=768m
SYSTEM_SERVICE_CPUS=2.0
GATEWAY_SERVICE_MEM_LIMIT=512m
AUTH_SERVICE_MEM_LIMIT=384m
FILE_SERVICE_MEM_LIMIT=384m
MESSAGE_SERVICE_MEM_LIMIT=384m
PLUGIN_SERVICE_MEM_LIMIT=384m
LOCALIZATION_SERVICE_MEM_LIMIT=320m
JOB_EXECUTOR_MEM_LIMIT=320m
XXL_JOB_ADMIN_MEM_LIMIT=384m
API_PROXY_MEM_LIMIT=128m

SAAS_TRAFFIC_GATEWAY_AUTH_SERVICE_QPS=120
SAAS_TRAFFIC_GATEWAY_FILE_SERVICE_QPS=80
SAAS_TRAFFIC_GATEWAY_MESSAGE_SERVICE_QPS=80
SAAS_TRAFFIC_GATEWAY_PLUGIN_SERVICE_QPS=50
SAAS_TRAFFIC_GATEWAY_LOCALIZATION_SERVICE_QPS=80
SAAS_TRAFFIC_GATEWAY_SYSTEM_SERVICE_QPS=160
SAAS_TRAFFIC_AUTH_LOGIN_QPS=20
SAAS_TRAFFIC_AUTH_REFRESH_TOKEN_QPS=80
SAAS_TRAFFIC_AUTH_CURRENT_USER_QPS=160

# Comma-separated exact lumira-ui origins allowed by the lumira-backend gateway.
# Do not use wildcard domains for the admin console.
CORS_ALLOWED_ORIGIN_PATTERNS=https://bm.aiadc.org.cn

# Backend API proxy bind address. Keep it on localhost when HTTPS is terminated
# by the edge proxy, host Nginx, 1Panel, a load balancer, or CDN tunnel.
API_PROXY_BIND=127.0.0.1:8000

# Local-only lumira-ui preview bind address. The edge proxy listens on 80/443.
FRONTEND_BIND=127.0.0.1:8001
