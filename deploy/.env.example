# Example values for deployment. Every value prefixed with change-me is a
# placeholder and must be replaced with a strong production secret before launch.

MYSQL_DATABASE=saas

APP_VERSION=0.1.0
BUILD_VERSION=
BUILD_TIME=
GIT_COMMIT=
GIT_BRANCH=

OBSERVABILITY_ENVIRONMENT=prod
OTEL_JAVAAGENT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password

REDIS_PASSWORD=

# Must be Base64 and decode to at least 32 bytes for Nacos 3.x.
NACOS_AUTH_TOKEN=Y2hhbmdlLW1lLW5hY29zLWF1dGgtdG9rZW4tYXQtbGVhc3QtMzItYnl0ZXM=
NACOS_AUTH_IDENTITY_KEY=change-me-nacos-identity-key
NACOS_AUTH_IDENTITY_VALUE=change-me-nacos-identity-value
NACOS_CONFIG_ENABLED=false
NACOS_DISCOVERY_ENABLED=false
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=

DB_USERNAME=root
DB_PASSWORD=change-me-strong-mysql-password
DB_URL=jdbc:mysql://1Panel-mysql-fWzH:3306/saas?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false

JWT_SECRET=change-me-at-least-32-characters-jwt-secret-for-production
FIELD_SECRET=change-me-at-least-32-characters-field-secret-for-production
PLUGIN_SIGNATURE_SECRET=change-me-at-least-32-characters-plugin-signature-secret
SAAS_JOB_INTERNAL_TOKEN=change-me-internal-job-token

XXL_JOB_ADMIN_ACCESS_TOKEN=change-me-xxl-job-token
XXL_JOB_ACCESS_TOKEN=change-me-xxl-job-token
XXL_JOB_LOGIN_PASSWORD=change-me-xxl-admin-password

DEFAULT_ADMIN_INIT_ENABLED=false
DEFAULT_ADMIN_PASSWORD_HASH=

UPLOAD_STORAGE_ROOT=/data/uploads
PLUGIN_STORAGE_ROOT=/data/plugins
PLUGIN_STAGING_ROOT=/data/plugin-staging
XXL_JOB_EXECUTOR_LOG_HOST_PATH=/opt/legendary-invention/data/xxl-job/logs

JAVA_OPTS=-XX:MaxRAMPercentage=75 -Djava.security.egd=file:/dev/./urandom

# Comma-separated exact frontend origins allowed by the backend gateway.
# Do not use wildcard domains for the admin console.
CORS_ALLOWED_ORIGIN_PATTERNS=https://admin.elexvx.com,https://elexvx.com

# Backend API proxy bind address. Keep 127.0.0.1 when HTTPS is terminated by
# host Nginx, 1Panel, a load balancer, or CDN tunnel. Use 0.0.0.0:8000 only
# when you intentionally expose this container port directly.
API_PROXY_BIND=127.0.0.1:8000
