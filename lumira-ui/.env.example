# Same-origin proxy fallback. This works for http://localhost:8000 and
# http://<LAN-IP>:8000 when the frontend dev server proxy is enabled.
UMI_APP_API_PREFIX=/api

# Optional build-time backend origin override. When omitted, requests use
# same-origin /api and WebSocket uses same-origin /ws/message.
# UMI_APP_API_BASE_URL=https://saas.elexvx.com

# Optional runtime override for local testing without rebuilding the frontend:
# localStorage.setItem('lumira:api_base_url', 'http://192.168.1.4:8080')
# localStorage.removeItem('lumira:api_base_url')

# Optional dev proxy target. The browser still calls /api on the frontend host.
# UMI_DEV_API_TARGET=http://127.0.0.1:8080

# Frontend fetch timeout in milliseconds. Set to 0 to disable client-side abort.
UMI_APP_REQUEST_TIMEOUT=10000
