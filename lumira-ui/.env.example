# Same-origin proxy fallback. In container deployment, /api is served by the
# same saas.elexvx.com edge proxy as the lumira-ui.
UMI_APP_API_PREFIX=/api

# Optional backend origin override. When omitted, requests use same-origin /api
# and WebSocket uses same-origin /ws/message.
# UMI_APP_API_BASE_URL=https://saas.elexvx.com

# Frontend fetch timeout in milliseconds. Set to 0 to disable client-side abort.
UMI_APP_REQUEST_TIMEOUT=10000
