{
  "name": "saas-lumira-ui",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/console-banner.mjs && max dev",
    "build": "max setup && max build && node scripts/adapt-cdn-assets.mjs",
    "start": "node scripts/console-banner.mjs && max preview",
    "lint": "max lint",
    "stylelint": "max lint --stylelint-only",
    "typecheck": "max setup && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "corepack pnpm run test:captcha-load && corepack pnpm run test:captcha-refresh && corepack pnpm run test:auth-login-flow && corepack pnpm run test:captcha-input && corepack pnpm run test:theme-nav-sync && corepack pnpm run test:theme-runtime-bridge && corepack pnpm run test:theme-official-alignment && corepack pnpm run test:api-response-shape && corepack pnpm run test:login-error-feedback && corepack pnpm run test:permission-tree && corepack pnpm run test:gap-closure-routes && corepack pnpm run test:login-redirect-target && corepack pnpm run test:login-storage-sync && corepack pnpm run test:online-users-session-removal && corepack pnpm run test:antd-static-theme",
    "test:captcha-load": "tsx scripts/captcha-load-smoke.ts",
    "test:captcha-refresh": "tsx scripts/captcha-refresh-smoke.ts",
    "test:auth-login-flow": "tsx scripts/auth-login-flow-smoke.ts",
    "test:captcha-input": "tsx scripts/captcha-input-smoke.ts",
    "test:theme-nav-sync": "tsx scripts/theme-nav-sync-smoke.ts",
    "test:theme-runtime-bridge": "tsx scripts/theme-runtime-bridge-smoke.ts",
    "test:theme-official-alignment": "tsx scripts/theme-official-alignment-smoke.ts",
    "test:api-response-shape": "tsx scripts/api-response-shape-smoke.ts",
    "test:login-error-feedback": "tsx scripts/login-error-feedback-smoke.ts",
    "test:permission-tree": "tsx scripts/permission-tree-normalize-smoke.ts",
    "test:gap-closure-routes": "tsx scripts/gap-closure-routes-smoke.ts",
    "test:login-redirect-target": "tsx scripts/login-redirect-target-smoke.ts",
    "test:login-storage-sync": "tsx scripts/login-storage-sync-smoke.ts",
    "test:online-users-session-removal": "tsx scripts/online-users-session-removal-smoke.ts",
    "test:antd-static-theme": "tsx scripts/antd-static-theme-smoke.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:reset": "node ../bin/reset-e2e-platform.mjs && playwright test",
    "test:e2e:reset:smoke": "node ../bin/reset-e2e-platform.mjs && playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@ant-design/pro-components": "^3.1.12-0",
    "@ant-design/x": "^2.7.0",
    "@ant-design/x-markdown": "^2.7.0",
    "@tanstack/react-query": "^5.100.9",
    "@umijs/max": "^4.6.51",
    "antd": "^6.3.7",
    "antd-img-crop": "^4.30.0",
    "dayjs": "^1.11.20",
    "rc-slider-captcha": "^1.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "less-loader": "^12.3.2",
    "postcss": "8.5.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "axios@0.27.2": "1.15.2",
      "@babel/runtime@7.23.6": "7.29.2",
      "@remix-run/router@<=1.23.1": "1.23.2",
      "esbuild@0.18.20": "0.25.12",
      "esbuild@0.21.4": "0.25.12",
      "immer@8.0.4": "9.0.21",
      "less-loader@11.1.0": "12.3.2",
      "node-fetch@1.7.3": "2.6.7",
      "path-to-regexp@1.7.0": "1.9.0",
      "path-to-regexp@8.2.0": "8.4.2",
      "postcss@<8.5.10": "8.5.14",
      "react-router@6.3.0": "6.30.2",
      "send@<0.19.0": "0.19.1",
      "vite@4.5.2": "6.4.2"
    }
  }
}
