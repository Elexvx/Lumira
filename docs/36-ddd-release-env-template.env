# Lumira DDD production-equivalent release evidence environment template.
# Copy to a secure CI secret store or local .env.release outside git, then replace every placeholder.
# This file is intentionally not lint-clean: example domains and replace-with-* values must be replaced before running ddd-release-env-file-lint.
# The generated artifacts/ddd/release/release-env-missing.template.env follows the same rule and is reported as inputKind=generated-missing-template, not as release evidence.

LUMIRA_BASE_URL=https://api.example.com
PLAYWRIGHT_BASE_URL=https://app.example.com

# Release evidence provenance. These values must identify the environment,
# exact release candidate, and operator for every generated evidence artifact.
DDD_EVIDENCE_ENVIRONMENT=replace-with-production-equivalent-environment
DDD_RELEASE_CANDIDATE=replace-with-git-sha-or-release-version
DDD_EVIDENCE_OPERATOR=replace-with-release-operator

# Optional Docker build mirrors. Use trusted internal mirrors when Docker Hub is unreliable.
DDD_DOCKER_BUILD_RETRIES=4
DDD_DOCKER_MAVEN_IMAGE=registry.example.internal/maven:3.9.11-eclipse-temurin-21
DDD_DOCKER_JRE_IMAGE=registry.example.internal/eclipse-temurin:21-jre
DDD_DOCKER_NODE_IMAGE=registry.example.internal/node:22-bookworm-slim
DDD_DOCKER_NGINX_IMAGE=registry.example.internal/nginx:1.29-alpine
DDD_DOCKER_OTEL_JAVAAGENT_URL=
MAVEN_IMAGE=registry.example.internal/maven:3.9.11-eclipse-temurin-21
JRE_IMAGE=registry.example.internal/eclipse-temurin:21-jre
NODE_IMAGE=registry.example.internal/node:22-bookworm-slim
NGINX_IMAGE=registry.example.internal/nginx:1.29-alpine
OTEL_JAVAAGENT_URL=

DB_URL=jdbc:mysql://mysql.example.internal:3306/lumira?useUnicode=true&characterEncoding=utf-8&useSSL=true&serverTimezone=Asia/Shanghai
DB_USERNAME=lumira_app
DB_PASSWORD=replace-with-secret-at-least-16-chars

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-secret-at-least-16-chars

JWT_SECRET=replace-with-strong-secret-at-least-32-chars
FIELD_SECRET=replace-with-strong-secret-at-least-32-chars
CORS_ALLOWED_ORIGIN_PATTERNS=https://app.example.com
TRUST_FORWARDED_HEADERS=true

SYSTEM_SERVICE_BASE_URL=https://system.example.internal
AUTH_SERVICE_BASE_URL=https://auth.example.internal
FILE_SERVICE_BASE_URL=https://file.example.internal
MESSAGE_SERVICE_BASE_URL=https://message.example.internal
PLUGIN_SERVICE_BASE_URL=https://plugin.example.internal
LOCALIZATION_SERVICE_BASE_URL=https://localization.example.internal
PAYMENT_SERVICE_BASE_URL=https://payment.example.internal
AI_SERVICE_BASE_URL=https://ai.example.internal
LUMIRA_AI_BASE_URL=https://ai.example.internal
JOB_EXECUTOR_BASE_URL=https://job.example.internal

SAAS_JOB_INTERNAL_TOKEN=replace-with-secret-at-least-32-chars
SAAS_JOB_BACKEND_BASE_URL=https://api.example.internal
SAAS_JOB_MESSAGE_SERVICE_BASE_URL=https://message.example.internal
SAAS_JOB_FILE_SERVICE_BASE_URL=https://file.example.internal
SAAS_JOB_PAYMENT_SERVICE_BASE_URL=https://payment.example.internal
SAAS_JOB_PLUGIN_SERVICE_BASE_URL=https://plugin.example.internal

XXL_JOB_ADMIN_ADDRESSES=https://xxl-job.example.internal/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=replace-with-secret-at-least-32-chars
SAAS_EVENT_OUTBOX_DISPATCHER=redis-stream
SAAS_EVENT_REDIS_STREAM_KEY=lumira:platform-events

UPLOAD_STORAGE_ROOT=/opt/lumira/data/uploads
LUMIRA_FILE_SECURITY_SCAN_MODE=CLAMAV
LUMIRA_FILE_OCR_MODE=TESSERACT

PAYMENT_PUBLIC_BASE_URL=https://api.example.com
PAYMENT_WEBHOOK_SECRET=replace-with-secret-at-least-32-chars

LUMIRA_AI_PROVIDER_OPENAI_COMPATIBLE_ENABLED=true
LUMIRA_AI_PROVIDER_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
LUMIRA_AI_PROVIDER_OPENAI_COMPATIBLE_API_KEY=replace-with-secret-at-least-32-chars
LUMIRA_AI_PROVIDER_OPENAI_COMPATIBLE_CHAT_MODEL=gpt-4o-mini
LUMIRA_AI_PROVIDER_OPENAI_COMPATIBLE_EMBEDDING_MODEL=text-embedding-3-small

LUMIRA_AI_OWNER_INTEGRATIONS_INTERNAL_TOKEN=replace-with-secret-at-least-32-chars
LUMIRA_AI_OWNER_INTEGRATIONS_IAM_ENABLED=true
LUMIRA_AI_OWNER_INTEGRATIONS_IAM_BASE_URL=https://system.example.internal
LUMIRA_AI_OWNER_INTEGRATIONS_PLATFORM_ENABLED=true
LUMIRA_AI_OWNER_INTEGRATIONS_PLATFORM_BASE_URL=https://system.example.internal
LUMIRA_AI_OWNER_INTEGRATIONS_FILE_ENABLED=true
LUMIRA_AI_OWNER_INTEGRATIONS_FILE_BASE_URL=https://file.example.internal
