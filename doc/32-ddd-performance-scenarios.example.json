{
  "description": "Example DDD hot-path smoke scenarios. Copy this file, replace credentials/provider payloads, set LUMIRA_BASE_URL, and pass it with DDD_SMOKE_SCENARIOS_FILE.",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/public/bootstrap",
      "expectedStatuses": [200]
    },
    {
      "method": "GET",
      "path": "/api/v2/auth/login-encryption-key",
      "expectedStatuses": [200]
    },
    {
      "method": "POST",
      "path": "/api/v2/auth/login",
      "body": {
        "username": "admin",
        "password": "replace-with-encrypted-password",
        "passwordCiphertext": "replace-with-real-ciphertext",
        "keyId": "replace-with-login-key-id",
        "captchaCode": "0000",
        "captchaToken": "replace-with-captcha-token"
      },
      "expectedStatuses": [200, 400, 401, 403, 429]
    },
    {
      "method": "GET",
      "path": "/api/v2/auth/current-user",
      "expectedStatuses": [200, 401, 403]
    },
    {
      "method": "GET",
      "path": "/api/v2/iam/permissions",
      "expectedStatuses": [200, 401, 403]
    },
    {
      "method": "GET",
      "path": "/api/v2/platform/public/bootstrap",
      "expectedStatuses": [200, 404]
    },
    {
      "method": "GET",
      "path": "/api/v2/message/unread-count",
      "expectedStatuses": [200, 401, 403]
    },
    {
      "method": "GET",
      "path": "/api/v2/message/messages?pageNo=1&pageSize=20",
      "expectedStatuses": [200, 401, 403]
    },
    {
      "method": "GET",
      "path": "/api/v2/localization/runtime/zh-CN",
      "expectedStatuses": [200, 401, 403]
    },
    {
      "method": "GET",
      "path": "/api/v2/plugins/current/bootstrap",
      "expectedStatuses": [200, 401, 403, 404]
    },
    {
      "method": "GET",
      "path": "/api/v2/files?pageNo=1&pageSize=20",
      "expectedStatuses": [200, 401, 403]
    },
    {
      "method": "POST",
      "path": "/api/v2/files/upload",
      "multipart": {
        "fields": {
          "category": "performance-smoke",
          "scope": "tenant"
        },
        "files": [
          {
            "fieldName": "file",
            "filename": "ddd-smoke.txt",
            "contentType": "text/plain",
            "content": "Lumira DDD performance smoke upload"
          }
        ]
      },
      "expectedStatuses": [200, 400, 401, 403]
    },
    {
      "method": "POST",
      "path": "/api/v2/payment/webhooks/mock",
      "body": {
        "eventId": "replace-with-provider-event-id",
        "orderNo": "replace-with-order-no",
        "status": "SUCCESS"
      },
      "expectedStatuses": [200, 400, 401, 403]
    },
    {
      "method": "POST",
      "path": "/api/v2/ai/chat",
      "body": {
        "employeeId": 1,
        "message": "ping",
        "knowledgeBaseIds": []
      },
      "expectedStatuses": [200, 400, 401, 403]
    }
  ]
}
