# Native local debugging only. Copy this file to lumira-backend/.env.
# bin/start-local.mjs loads it explicitly; Spring Boot does not load .env files.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LUMIRA_UI_PORT=8000
LUMIRA_ASYNC_PORT=8081
LUMIRA_JOB_PORT=8082

DB_URL=jdbc:mysql://127.0.0.1:3306/lumira?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Production update polling is not useful in native local mode. The launcher
# delays it for one day by default so a stale local schema cannot flood logs.
PLATFORM_UPDATE_CHECK_INITIAL_DELAY_MS=86400000
PLATFORM_UPDATE_TASK_RECONCILE_INITIAL_DELAY_MS=86400000

# Safe development-only secrets. Never reuse them in deploy/.env.
JWT_SECRET=lumira-local-jwt-secret-for-native-debugging-only-2026
FIELD_SECRET=lumira-local-field-secret-for-native-debugging-only-2026
PLUGIN_SIGNATURE_SECRET=lumira-local-plugin-signature-debug-secret-2026
SAAS_INTERNAL_SYSTEM_TOKEN=lumira-local-system-token-000001
SAAS_INTERNAL_AUTH_TOKEN=lumira-local-auth-token-000001
SAAS_INTERNAL_AUTH_SYSTEM_TOKEN=lumira-local-auth-system-token-000001
SAAS_INTERNAL_FILE_TOKEN=lumira-local-file-token-000001
SAAS_INTERNAL_MESSAGE_TOKEN=lumira-local-message-token-000001
SAAS_INTERNAL_PAYMENT_TOKEN=lumira-local-payment-token-000001
SAAS_INTERNAL_PLUGIN_TOKEN=lumira-local-plugin-token-000001
SAAS_INTERNAL_TEAM_TOKEN=lumira-local-team-token-000001
SAAS_INTERNAL_JOB_TOKEN=lumira-local-job-token-000001
