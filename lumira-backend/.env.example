# Native local debugging only. Copy this file to lumira-backend/.env.
# bin/start-local.mjs loads it explicitly; Spring Boot does not load .env files.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LUMIRA_UI_PORT=8000
LUMIRA_REVIEW_INVITATION_URL=http://localhost:8000/review/invitation
LUMIRA_ASYNC_PORT=8081
LUMIRA_JOB_PORT=8082

DB_URL=jdbc:mysql://127.0.0.1:3306/lumira?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
# Required. Leave empty only when the local MySQL account is passwordless.
DB_PASSWORD=

# On the first native dev startup, the launcher uses the one-time admin password
# 123456 and stores it under runtime-secrets/ with owner-only access. The first
# login must change it. This weak default is accepted only for dev + loopback MySQL.
# To provide your own strong one-time password instead, set this to a secret
# file path relative to the repository root. The first login must still change it.
LUMIRA_LOCAL_BOOTSTRAP_ADMIN_PASSWORD_FILE=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# An empty value is valid for a passwordless local Redis-compatible service.
REDIS_PASSWORD=
REDIS_DATABASE=0

# Production update polling is not useful in native local mode. The launcher
# delays it for one day by default so a stale local schema cannot flood logs.
PLATFORM_UPDATE_CHECK_INITIAL_DELAY_MS=86400000
PLATFORM_UPDATE_TASK_RECONCILE_INITIAL_DELAY_MS=86400000

# Leave these empty to let bin/start-local.mjs generate random values without
# shipping credentials. FIELD_SECRET is persisted once under runtime-secrets/
# so encrypted local database fields remain decryptable across restarts. Set it
# only when intentionally sharing an existing local encryption key; never commit
# populated values.
JWT_SECRET=
FIELD_SECRET=
PLUGIN_SIGNATURE_SECRET=
SPRING_SECURITY_USER_PASSWORD=
SAAS_INTERNAL_SYSTEM_TOKEN=
SAAS_INTERNAL_AUTH_TOKEN=
SAAS_INTERNAL_AUTH_SYSTEM_TOKEN=
SAAS_INTERNAL_FILE_TOKEN=
SAAS_INTERNAL_MESSAGE_TOKEN=
SAAS_INTERNAL_PAYMENT_TOKEN=
SAAS_INTERNAL_PLUGIN_TOKEN=
SAAS_INTERNAL_TEAM_TOKEN=
SAAS_INTERNAL_JOB_TOKEN=
