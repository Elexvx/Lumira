# Lumira DDD staging next-action environment template.
# Generated from the immediate staging owner action queue.
# Fill values in a secure env file or CI secret store. Do not commit populated secrets.
# Status: BLOCKED
# Next command: node scripts/ddd-staging-execution-checklist.mjs --release-env-next-owner-template

# Lane: p0-release-env
# Owner: release-infra
# Action: Fill and validate the secure release env file
# Command: node scripts/ddd-staging-execution-checklist.mjs --release-env-next-owner-template
# Source: release-env-plan.json
DDD_RELEASE_ENV_FILE=__REQUIRED__

# Lane: p1-runtime-business
# Owner: release-infra
# Action: Publish HTTPS backend/frontend staging URLs and attach deployment evidence for strict runtime checks.
# Command: node scripts/ddd-staging-execution-checklist.mjs --runtime-business-submission-plan-markdown
# Source: runtime-business-submission-plan.json
LUMIRA_BASE_URL=__REQUIRED_HTTPS__
PLAYWRIGHT_BASE_URL=__REQUIRED_HTTPS__
DDD_DEPLOYMENT_EVIDENCE=__REQUIRED__
DDD_FRONTEND_DEPLOYMENT_EVIDENCE=__REQUIRED__
DDD_FRONTEND_EXPECT_DEPLOYED=true

# Lane: p1-p2-data-safety
# Owner: bounded-context owners
# Action: Provide rollback drill evidence or an approved rollback deferral for every affected bounded context.
# Command: node scripts/ddd-staging-execution-checklist.mjs --data-safety-submission-plan-markdown
# Source: data-safety-submission-plan.json
# Choose one of: DDD_ROLLBACK_DRILL_FILE, DDD_ROLLBACK_DRILL_DEFERRAL_FILE
DDD_ROLLBACK_DRILL_FILE=__REQUIRED__
DDD_ROLLBACK_DRILL_DEFERRAL_FILE=__REQUIRED__
# Choose one of: DDD_ROLLBACK_DRILL_ENVIRONMENT, DDD_EVIDENCE_ENVIRONMENT, DDD_RELEASE_ENVIRONMENT
DDD_ROLLBACK_DRILL_ENVIRONMENT=staging
DDD_EVIDENCE_ENVIRONMENT=staging
DDD_RELEASE_ENVIRONMENT=staging
# Choose one of: DDD_RELEASE_CANDIDATE, GITHUB_SHA
DDD_RELEASE_CANDIDATE=__REQUIRED_SHA_OR_TAG__
GITHUB_SHA=__REQUIRED_SHA_OR_TAG__
# Choose one of: DDD_EVIDENCE_OPERATOR, GITHUB_ACTOR
DDD_EVIDENCE_OPERATOR=__REQUIRED__
GITHUB_ACTOR=__REQUIRED__

# Validation sequence
# node scripts/ddd-staging-execution-checklist.mjs --next-action-queue
# node scripts/ddd-staging-execution-checklist.mjs --evidence-acceptance
# node scripts/ddd-staging-execution-checklist.mjs --final-review-enforce
