# DDD_FINAL_OWNER_QUEUE_CHECK_ENV=1 DDD_FINAL_OWNER_QUEUE_OWNER=release-infra bash artifacts/ddd/release/release-final-owner-queue-commands.sh
# DDD_FINAL_OWNER_QUEUE_EXECUTE=1 DDD_FINAL_OWNER_QUEUE_OWNER=release-infra bash artifacts/ddd/release/release-final-owner-queue-commands.sh
# DDD_FINAL_OWNER_QUEUE_CONTINUE_ON_ERROR=1 DDD_FINAL_OWNER_QUEUE_EXECUTE=1 DDD_FINAL_OWNER_QUEUE_OWNER=release-infra bash artifacts/ddd/release/release-final-owner-queue-commands.sh # diagnostic only; final exit remains non-zero on failures
